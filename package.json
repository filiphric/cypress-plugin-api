    "autoprefixer": "^10.4.16",
    "cypress": "^15.8.1",
    "eslint": "^9.39.2",
    "eslint-plugin-no-only-tests": "^3.1.0",
    "eslint-plugin-vue": "^9.33.0",
    "express": "^4.22.1",
    "generate-changelog": "^1.8.0",
    "husky": "^8.0.3",
    "postcss": "^8.4.32",
